{
  "crons": [
    {
      "path": "/api/cron/roamly-notifications",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/roamly-social-autopost",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/roamly-itinerary-generation",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/roamly-booking-monitor",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "app/api/**/*.ts": {
      "includeFiles": [
        "node_modules/@ffmpeg-installer/linux-x64/ffmpeg",
        "node_modules/ffprobe-static/bin/linux/x64/ffprobe"
      ]
    }
  }
}
