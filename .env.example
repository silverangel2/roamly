# Roamly — environment variables (rewritten 2026-11-11, Stage 8)
#
# Every name the code actually reads: direct process.env reads across
# app/ components/ lib/ + the keys read dynamically by the provider
# adapters, the generation scalability knobs, and the email module's
# readEnv() calls. NO VALUES are shown — copy the names, fill them in
# your own environment (Vercel project env for production). Lines
# marked [SECRET] are credentials: never commit real values.
#
# Production facts (names only): the Roamly Vercel project carries 28
# variables; ROAMLY_ADMIN_CODE + ROAMLY_ADMIN_SESSION_SECRET are
# REQUIRED for the /admin door to open at all (absent = the door
# fails closed by design).

# ------------------------------------------------------------------
# App + Supabase (the data spine)
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=            # Public base URL of the app (links, callbacks).
NEXT_PUBLIC_SITE_URL=           # Canonical site URL used by email/OAuth helpers.
NEXT_PUBLIC_ROAMLY_APP_NAME=    # Display name override (lib/env.ts).
NEXT_PUBLIC_SUPABASE_URL=       # Supabase project URL (browser + server).
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # Supabase anon key (browser client; RLS-bound).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # Supabase publishable key (newer key format, config fallback).
SUPABASE_URL=                   # Server-side Supabase URL override (uploads route).
SUPABASE_SERVICE_ROLE_KEY=      # [SECRET] Service-role key — bypasses RLS; server only, never browser.
NODE_ENV=                       # Runtime mode (development/production) — platform-set.
TZ=                             # Process timezone hint for social caption scheduling.

# ------------------------------------------------------------------
# Admin door + owner
# ------------------------------------------------------------------
ROAMLY_ADMIN_CODE=              # [SECRET] The /admin-access code (hashed compare). Required for admin.
ROAMLY_ADMIN_SESSION_SECRET=    # [SECRET] Signs admin session cookies. Required for admin.
ROAMLY_ADMIN_EMAILS=            # Comma list of admin email addresses (settings page).
ROAMLY_OWNER_ALERT_EMAIL=       # Where operational owner alerts are sent.
ROAMLY_SUPPORT_EMAIL=           # Support mailbox shown/used by the system.
ROAMLY_TESTER_EMAILS=           # Comma list of QA tester accounts (setup-gate + checkout bypass by design).

# ------------------------------------------------------------------
# OpenAI (generation + extraction + vision)
# ------------------------------------------------------------------
OPENAI_API_KEY=                 # [SECRET] OpenAI API key for all AI calls.
OPENAI_MODEL=                   # Default itinerary model.
OPENAI_FALLBACK_MODEL=          # Fallback model when the primary is unavailable.
OPENAI_VISION_MODEL=            # Model for screenshot/booking-image reading.
OPENAI_BOOKING_EXTRACTION_MODEL= # Model for Booking Recon extraction.
OPENAI_COMPANION_IMPACT_MODEL=  # Model for Live Companion impact analysis.
OPENAI_SOCIAL_MODEL=            # Model for social post generation.
OPENAI_DAY_BATCH_MAX_TOKENS=    # Token cap for one day-batch generation call.
OPENAI_DAY_TIMEOUT_MS=          # Timeout for one day-batch call.
OPENAI_OUTLINE_MAX_TOKENS=      # Token cap for the outline generation call.
OPENAI_OUTLINE_TIMEOUT_MS=      # Timeout for the outline call.
ROAMLY_OPENAI_BASE_URL=         # OpenAI-compatible base URL override.
ROAMLY_OPENAI_INPUT_PRICE_PER_1M=  # Input token price (USD/1M) for AI cost accounting.
ROAMLY_OPENAI_OUTPUT_PRICE_PER_1M= # Output token price (USD/1M) for AI cost accounting.
ROAMLY_OPENAI_DAILY_TOKEN_LIMIT=   # Daily OpenAI token ceiling for generation.
ROAMLY_PRIMARY_AI_PROVIDER=     # Primary AI provider selector for staged generation.

# ------------------------------------------------------------------
# Stripe (one-time prices; CAD + PHP)
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=              # [SECRET] Stripe API secret key — server only.
STRIPE_WEBHOOK_SECRET=          # [SECRET] Stripe webhook signing secret.
ROAMLY_STRIPE_ITINERARY_PRICE_ID=     # CAD price: Full Itinerary.
ROAMLY_STRIPE_FEATURES_PRICE_ID=      # CAD price: Live Trip Companion.
ROAMLY_STRIPE_COMPLETE_TRIP_PRICE_ID= # CAD price: Complete Trip Pack.
ROAMLY_STRIPE_ITINERARY_PRICE_ID_PHP=     # PHP price: Full Itinerary.
ROAMLY_STRIPE_FEATURES_PRICE_ID_PHP=      # PHP price: Live Trip Companion.
ROAMLY_STRIPE_COMPLETE_TRIP_PRICE_ID_PHP= # PHP price: Complete Trip Pack.
ROAMLY_STRIPE_ACTIVATED_TRIP_PRICE_ID=    # Price used for already-activated trips (lib/env.ts).
ROAMLY_STRIPE_ITINERARY_UNLOCK_PRICE_ID=  # Legacy alias read by the admin system route.
ROAMLY_STRIPE_TRACKING_ADDON_PRICE_ID=    # Legacy alias read by the admin system route.
ROAMLY_STRIPE_TRIP_BUNDLE_PRICE_ID=       # Legacy alias read by the admin system route.

# ------------------------------------------------------------------
# Email sending (SMTP or Resend) + capture
# ------------------------------------------------------------------
ROAMLY_EMAIL_PROVIDER=          # Sender provider selector (smtp/resend).
ROAMLY_SMTP_HOST=               # SMTP host (ROAMLY_ prefix wins over the SMTP_ fallback).
ROAMLY_SMTP_PORT=               # SMTP port.
ROAMLY_SMTP_USER=               # SMTP username.
ROAMLY_SMTP_PASSWORD=           # [SECRET] SMTP password.
ROAMLY_SMTP_SECURE=             # SMTP TLS mode (defaults from port 465).
SMTP_HOST=                      # Fallback SMTP host when ROAMLY_SMTP_HOST is unset.
SMTP_PORT=                      # Fallback SMTP port.
SMTP_USER=                      # Fallback SMTP username.
SMTP_PASSWORD=                  # [SECRET] Fallback SMTP password.
SMTP_SECURE=                    # Fallback SMTP TLS mode.
RESEND_API_KEY=                 # [SECRET] Resend API key (when provider = resend).
ROAMLY_FROM_EMAIL=              # From address for Roamly mail.
ROAMLY_FROM_NAME=               # From display name.
ROAMLY_REPLY_TO_EMAIL=          # Reply-To address.
ROAMLY_EMAIL_CAPTURE_ENABLED=   # Capture-mode switch: renders + logs mail without sending (test lanes).
ROAMLY_DAILY_TEST_EMAIL=        # The daily-test recipient — the only address the capture predicate exempts by exact match.
ROAMLY_EMAIL_REMINDERS_ENABLED= # Master switch for reminder emails.
ROAMLY_COMPLETION_EMAIL_MAX_ATTEMPTS= # Send-attempt cap for completion emails.
ROAMLY_EMAIL_VERIFY_SECRET=     # [SECRET] Secret for email verification links.

# ------------------------------------------------------------------
# Booking Recon — Gmail + Outlook connections
# ------------------------------------------------------------------
GOOGLE_GMAIL_CLIENT_ID=         # Google OAuth client id for Gmail connect.
GOOGLE_GMAIL_CLIENT_SECRET=     # [SECRET] Google OAuth client secret.
GOOGLE_GMAIL_REDIRECT_URI=      # Google OAuth redirect URI.
ROAMLY_GMAIL_PUBSUB_TOPIC=      # Pub/Sub topic for Gmail push notifications.
ROAMLY_GMAIL_WEBHOOK_SECRET=    # [SECRET] Shared secret on the Gmail webhook (constant-time compare).
MICROSOFT_OUTLOOK_CLIENT_ID=    # Microsoft OAuth client id for Outlook connect.
MICROSOFT_OUTLOOK_CLIENT_SECRET= # [SECRET] Microsoft OAuth client secret.
MICROSOFT_OUTLOOK_REDIRECT_URI= # Microsoft OAuth redirect URI.
MICROSOFT_OUTLOOK_TENANT_ID=    # Microsoft tenant id for the Outlook OAuth flow.
MICROSOFT_OUTLOOK_WEBHOOK_URL=  # Public webhook URL registered with Microsoft Graph.
ROAMLY_OUTLOOK_WEBHOOK_SECRET=  # [SECRET] Shared secret on the Outlook webhook.
ROAMLY_TOKEN_ENCRYPTION_KEY=    # [SECRET] Encrypts stored mailbox OAuth tokens at rest.

# ------------------------------------------------------------------
# Cron + webhook + door secrets
# ------------------------------------------------------------------
CRON_SECRET=                    # [SECRET] Bearer secret for cron routes (constant-time compare).
ROAMLY_GENERATION_CRON_SECRET=  # [SECRET] Generation-sweep cron secret.
ROAMLY_NOTIFICATION_CRON_SECRET= # [SECRET] Notification cron secret.
ROAMLY_SOCIAL_CRON_SECRET=      # [SECRET] Social autopost cron secret.
SOCIAL_CRON_SECRET=             # [SECRET] Legacy social cron secret name.
ROAMLY_AFFILIATE_WEBHOOK_SECRET= # [SECRET] Affiliate conversion webhook secret.
ROAMLY_FIELD_TEST_SECRET=       # [SECRET] Field-test door secret.
ROAMLY_SESSION_TOKEN_SECRET=    # [SECRET] Signs Roamly session tokens.

# ------------------------------------------------------------------
# Affiliates + links
# ------------------------------------------------------------------
ROAMLY_AFFILIATES_ENABLED=      # Master switch for affiliate link rendering.
ROAMLY_AMAZON_ENABLED=          # Switch for Amazon gear links.
ROAMLY_AMAZON_ASSOCIATE_TAG=    # Amazon Associates tag appended to gear links.
ROAMLY_AMAZON_MARKETPLACE=      # Amazon marketplace domain selector.
ROAMLY_AMAZON_CREATORS_CLIENT_ID=     # Amazon Creators API client id (live prices/images).
ROAMLY_AMAZON_CREATORS_CLIENT_SECRET= # [SECRET] Amazon Creators API client secret.
ROAMLY_AMAZON_CREATORS_VERSION=       # Amazon Creators API version.
ROAMLY_STAY22_PARTNER_ID=       # Stay22 partner id for stay links.
ROAMLY_STAY22_REFERRAL_URL=     # Stay22 referral base URL.
ROAMLY_STAY22_SMART_LINK_URL=   # Stay22 smart-link base URL.
ROAMLY_KLOOK_PARTNER_ID=        # Klook partner id (also the finds served-suite fixture name).
ROAMLY_KLOOK_REFERRAL_URL=      # Klook referral base URL.
ROAMLY_TRAVELPAYOUTS_MARKER=    # Travelpayouts marker for flight/hotel links.
NEXT_PUBLIC_TRAVELPAYOUTS_DRIVE_ENABLED= # Loads the Travelpayouts Drive script in the browser.
ROAMLY_ATTRACTIONS_AFFILIATE_PROVIDER= # Attractions link provider selector (default klook).
ROAMLY_FLIGHT_AFFILIATE_PROVIDER=      # Flight link provider selector.
ROAMLY_HOTEL_AFFILIATE_PROVIDER=       # Hotel link provider selector.
ROAMLY_ESIM_PROVIDER=           # eSIM link provider selector.
ROAMLY_ESIM_AFFILIATE_ID=       # eSIM affiliate id.
ROAMLY_ESIM_REFERRAL_URL=       # eSIM referral base URL.

# ------------------------------------------------------------------
# Places, maps, hotel inventory, search providers
# ------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=            # [SECRET] Google Maps/Places server key.
GOOGLE_DISTANCE_MATRIX_API_KEY= # [SECRET] Google Distance Matrix key.
OPEN_PLACES_API_KEY=            # [SECRET] Open Places data key.
FIRECRAWL_API_KEY=              # [SECRET] Firecrawl scraping key (evidence fetching).
ROAMLY_PLACES_PROVIDER=         # Places provider selector (admin system page).
BOOKING_DEMAND_AFFILIATE_ID=    # Booking.com demand API affiliate id.
BOOKING_DEMAND_API_TOKEN=       # [SECRET] Booking.com demand API token.
BOOKING_DEMAND_BASE_URL=        # Booking.com demand API base URL.
BOOKING_DEMAND_BOOKER_COUNTRY=  # Booker country sent to the demand API.
ROAMLY_HOTEL_INVENTORY_PROVIDER= # Hotel inventory provider selector.
ROAMLY_HOTEL_INVENTORY_TIMEOUT_MS= # Hotel inventory call timeout.
ROAMLY_HOTEL_RATE_TTL_MINUTES=  # Hotel rate cache lifetime.
TRAVELPAYOUTS_API_TOKEN=        # [SECRET] Travelpayouts data API token.
KLOOK_API_KEY=                  # [SECRET] Klook API key.
ROAMLY_MARKET_SEARCH_ENABLED=   # Switch for travel market search.
ROAMLY_TRAVEL_DISCOVERY_QUERIES=      # Discovery query set for market search.
ROAMLY_TRAVEL_DISCOVERY_LIMIT_PER_QUERY= # Per-query result cap for market search.
ROAMLY_TRAVEL_EVIDENCE_PROVIDER=      # Evidence provider selector.
# Provider keys read dynamically by lib/roamly/providers/adapters.ts:
ROAMLY_BUS_PROVIDER_API_KEY=    # [SECRET] Bus inventory provider key.
ROAMLY_CURRENCY_API_KEY=        # [SECRET] Currency conversion provider key.
ROAMLY_FERRY_PROVIDER_API_KEY=  # [SECRET] Ferry inventory provider key.
ROAMLY_RAIL_PROVIDER_API_KEY=   # [SECRET] Rail inventory provider key.
ROAMLY_REVIEWS_PROVIDER_API_KEY= # [SECRET] Reviews provider key.
ROAMLY_WEATHER_API_KEY=         # [SECRET] Weather provider key.

# ------------------------------------------------------------------
# Generation engine + packs (tuning knobs; defaults in code)
# ------------------------------------------------------------------
ROAMLY_GENERATION_CONCURRENCY=  # Parallel generation workers.
ROAMLY_GENERATION_BATCH_SIZE=   # Jobs claimed per worker pass.
ROAMLY_GENERATION_LEASE_SECONDS= # Job lease length.
ROAMLY_GENERATION_MAX_RETRIES=  # Job retry cap.
ROAMLY_GENERATION_RETRY_BASE_SECONDS= # Retry backoff base.
ROAMLY_GENERATION_RETRY_MAX_SECONDS=  # Retry backoff cap.
ROAMLY_GENERATION_RETRY_BUDGET=       # Total retry budget per job.
ROAMLY_GENERATION_EXECUTION_BUDGET_MS= # Per-run execution budget.
ROAMLY_GENERATION_STAGE_CLEANUP_BUFFER_MS= # Stage cleanup buffer.
ROAMLY_GENERATION_MAX_LAYERS_PER_RUN= # Layer cap per generation run.
ROAMLY_GENERATION_COST_BUDGET_USD=    # Per-run AI cost budget.
ROAMLY_FREE_GENERATION_DAILY_LIMIT=   # Free-tier generations per day.
ROAMLY_PAID_GENERATION_DAILY_LIMIT=   # Paid-tier generations per day.
ROAMLY_FREE_QUEUE_PRIORITY=     # Queue priority weight: free tier.
ROAMLY_PAID_QUEUE_PRIORITY=     # Queue priority weight: paid tier.
ROAMLY_QA_QUEUE_PRIORITY=       # Queue priority weight: QA/tester jobs.
ROAMLY_PROVIDER_RATE_LIMITS_JSON= # JSON map of per-provider rate limits.
ROAMLY_STAGED_BATCH_ATTEMPT_LIMIT=    # Day-batch attempt cap (engine).
ROAMLY_STAGED_GENERATION_LEASE_MS=    # Staged generation lease.
ROAMLY_STAGED_VALIDATION_REPAIR_ATTEMPT_LIMIT= # Validation-repair attempt cap.
ROAMLY_STAGED_MAX_AI_COST_USD=  # Max AI cost per staged generation.
ROAMLY_ZERO_ENGINE_MAX_PACK_WAIT_MS= # Engine pack-wait cap (the 2h rule).
ROAMLY_PACK_DRIVE_BUDGET_MS=    # Time budget for pack (re)builds on the drive.
ROAMLY_PACK_STORE=              # Pack store backend selector.
ROAMLY_PACK_EXTRACT_URL_TEMPLATE= # Overture extract download URL template (fast data lane).
ROAMLY_PACK_EXTRACT_DIR=        # Local pack extract directory (dev/self-host).
ROAMLY_KITINERARY_BIN=          # Path to the Kitinerary binary (KDE booking extraction).

# ------------------------------------------------------------------
# Push, ads, analytics
# ------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # Web Push VAPID public key (browser).
VAPID_PRIVATE_KEY=              # [SECRET] Web Push VAPID private key.
VAPID_SUBJECT=                  # Web Push VAPID subject (mailto:).
NEXT_PUBLIC_ANALYTICS_ID=       # Analytics id (admin launch page).
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT= # AdSense client id.
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_HOME_HORIZONTAL= # AdSense slot: home horizontal.
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_HOME_NATIVE=     # AdSense slot: home native.
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_HOME_FOOTER=     # AdSense slot: home footer.

# ------------------------------------------------------------------
# Social autoposting (Meta)
# ------------------------------------------------------------------
ROAMLY_SOCIAL_AUTOPOST_ENABLED= # Master switch for social autoposting.
ROAMLY_SOCIAL_FACEBOOK_ENABLED= # Facebook posting switch.
ROAMLY_SOCIAL_INSTAGRAM_ENABLED= # Instagram posting switch.
ROAMLY_SOCIAL_REQUIRE_APPROVAL= # Require owner approval before posting.
ROAMLY_META_APP_ID=             # Meta app id (Facebook connect flow).
ROAMLY_META_APP_SECRET=         # [SECRET] Meta app secret.
ROAMLY_META_PAGE_ID=            # Facebook Page id.
ROAMLY_META_ACCESS_TOKEN=       # [SECRET] Meta page access token.
ROAMLY_META_REDIRECT_URI=       # Meta OAuth redirect URI.
ROAMLY_INSTAGRAM_BUSINESS_ACCOUNT_ID= # Instagram business account id.
ROAMLY_TIME_ZONE=               # Timezone for social scheduling.
FFMPEG_PATH=                    # Path to ffmpeg (social reel rendering).

# ------------------------------------------------------------------
# Ops, keeper, daily test, maintenance
# ------------------------------------------------------------------
ROAMLY_KEEPER_REPAIRS=          # Keeper repair powers: "on" enables the stuck completion-email re-drive (Production = on).
ROAMLY_OPS_AUTODEPLOY=          # Ops worker autodeploy switch.
ROAMLY_OPS_AUTODEPLOY_DAILY_CAP= # Ops autodeploy daily cap.
ROAMLY_PUBLIC_BASE_URL=         # Public base URL for ops callbacks.
ROAMLY_APP_URL=                 # App URL for companion notifications.
ROAMLY_MAINTENANCE_MODE=        # Maintenance gate switch.
ROAMLY_DAILY_TEST_ENABLED=      # Daily-test route switch.
ROAMLY_DAILY_TEST_PROVISIONING= # Daily-test provisioning mode (dailyTestClaim).
ROAMLY_ENABLE_DEMO_SEED=        # Allows the demo-seed route outside development.

# ------------------------------------------------------------------
# Sophie doors (legacy command surface; pass-based)
# ------------------------------------------------------------------
SOPHIE_PUBLIC_KEY=              # Public key verifying Sophie pass signatures.
SOPHIE_COMMAND_KEY=             # [SECRET] Legacy Sophie command key — retirement = deleting this variable once pass-only usage is proven (Stage 5 decision).

# ------------------------------------------------------------------
# Platform-provided (set by Vercel; listed so the census is complete)
# ------------------------------------------------------------------
VERCEL_ENV=                     # Vercel environment name (production/preview/development).
VERCEL_URL=                     # Deployment URL assigned by Vercel.
VERCEL_DEPLOYMENT_ID=           # Deployment id (communication orchestration).
VERCEL_GIT_COMMIT_SHA=          # Commit SHA shown by the build-stamp route.

# ------------------------------------------------------------------
# Removed in the 2026-11-11 rewrite (documented, no longer read):
# NEXT_PUBLIC_AIRALO_IMPACT_ENABLED, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY,
