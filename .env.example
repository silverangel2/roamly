# ROAMLY_ESIM_ENABLED, ROAMLY_EXPEDIA_AFFILIATE_ID,
# ROAMLY_FLIGHT_AFFILIATE_ID, ROAMLY_GETYOURGUIDE_PARTNER_ID,
# ROAMLY_HOTEL_AFFILIATE_ID, ROAMLY_META_GRAPH_VERSION,
# ROAMLY_PUBLIC_SOCIAL_MEDIA_BUCKET, ROAMLY_SOCIAL_MAX_DAILY_POSTS,
# ROAMLY_SOCIAL_MAX_QUEUE_SIZE, ROAMLY_SOCIAL_MIN_QUEUE_SIZE,
